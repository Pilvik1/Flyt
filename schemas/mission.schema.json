{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flytv1.local/schemas/mission.schema.json",
  "title": "Flyt mission brief",
  "type": "object",
  "required": ["goal", "workspacePath", "acceptanceCriteria"],
  "properties": {
    "goal": { "type": "string", "minLength": 1 },
    "workspacePath": { "type": "string", "minLength": 1 },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "constraints": {
      "type": "array",
      "items": { "type": "string" }
    },
    "providerProfile": {
      "type": "string",
      "enum": ["claude-only", "codex-only", "mixed"]
    }
  },
  "additionalProperties": false
}

